<?xml version="1.0" encoding="utf-8"?>
<!-- The HUD's menu. FrameRating caps its height to the screen, and the
     ScrollView scrolls whatever does not fit, so it is never cut off. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/SVHudMenu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/hud_panel_background"
    android:fadeScrollbars="false"
    android:scrollbarThumbVertical="@android:color/darker_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/HudMenuLabel"
                    android:text="@string/hud_template" />

                <LinearLayout
                    android:id="@+id/LLHudTemplates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HudMenuLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/hud_scale" />

                    <TextView
                        android:id="@+id/TVHudScale"
                        style="@style/HudMenuValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/SBHudScale"
                    style="@style/HudMenuSeekBar"
                    android:max="15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HudMenuLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/hud_background_opacity" />

                    <TextView
                        android:id="@+id/TVHudOpacity"
                        style="@style/HudMenuValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/SBHudOpacity"
                    style="@style/HudMenuSeekBar"
                    android:max="20" />

                <TextView
                    style="@style/HudMenuLabel"
                    android:layout_marginTop="8dp"
                    android:text="@string/fps_limit" />

                <LinearLayout
                    android:id="@+id/LLHudLimits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/HudMenuLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/hud_show_in_custom" />

                <LinearLayout
                    android:id="@+id/LLHudItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HudMenuLabel"
                    android:text="@string/frame_generation" />

                <CheckBox
                    android:id="@+id/CBHudFg"
                    style="@style/HudMenuCheckBox"
                    android:text="@string/frame_gen_enable" />

                <LinearLayout
                    android:id="@+id/LLHudFgMultiplier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HudMenuLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/frame_gen_flow_scale" />

                    <TextView
                        android:id="@+id/TVHudFlowScale"
                        style="@style/HudMenuValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/SBHudFlowScale"
                    style="@style/HudMenuSeekBar"
                    android:max="75" />

                <CheckBox
                    android:id="@+id/CBHudFgAdaptive"
                    style="@style/HudMenuCheckBox"
                    android:text="@string/hud_fg_adaptive" />

                <TextView
                    android:id="@+id/TVHudFgStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/frame_gen_requirements"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/BTHudSaveToShortcut"
                style="@style/HudMenuButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:text="@string/hud_save_to_shortcut" />

            <TextView
                android:id="@+id/BTHudDone"
                style="@style/HudMenuButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/hud_button_primary"
                android:text="@string/hud_done"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
